# --- Database ---
POSTGRES_USER=contextiq
POSTGRES_PASSWORD=contextiq
POSTGRES_DB=contextiq
DATABASE_URL=postgresql+psycopg2://contextiq:contextiq@localhost:5432/contextiq

# --- LLM ---
OPENAI_API_KEY=

# --- Agent LLM provider (Phase 6) ---
# Default: local Ollama model, no API key required. Run `ollama pull qwen3:4b`
# and make sure `ollama serve` is running (the desktop app does this
# automatically) before using the agent.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Security (Phase 13) ---
# When false (default), the run_sql tool only allows read-only queries.
ALLOW_DESTRUCTIVE_SQL=false

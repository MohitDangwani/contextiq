# --- Database ---
POSTGRES_USER=contextiq
POSTGRES_PASSWORD=contextiq
POSTGRES_DB=contextiq
DATABASE_URL=postgresql+psycopg2://contextiq:contextiq@localhost:5432/contextiq

# --- LLM ---
OPENAI_API_KEY=

# --- Agent LLM provider (Phase 6) ---
# Default: local Ollama model, no API key required. Run `ollama pull qwen3:4b`
# and make sure `ollama serve` is running (the desktop app does this
# automatically) before using the agent.
#
# Alternative: set LLM_PROVIDER=lmstudio to use a local LM Studio server
# instead (OpenAI-compatible API). Start LM Studio's local server and load
# a tool-calling-capable model first. LMSTUDIO_API_KEY is a non-secret
# placeholder -- LM Studio's local server does not validate it.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

LMSTUDIO_MODEL=nvidia/nemotron-3-nano-4b
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio

# Reasoning models (e.g. Nemotron) spend tokens on hidden reasoning before
# emitting a tool call or final answer -- keep this generous.
LLM_MAX_TOKENS=2048

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API (frontend dev server by default).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Security (Phase 13) ---
# When false (default), the run_sql tool only allows read-only queries.
ALLOW_DESTRUCTIVE_SQL=false
